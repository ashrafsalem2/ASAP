<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ASAP.Extensions.Sdk</RootNamespace>
    <Description>Write an extension for ASAP ERP. An extension is declared the same way every module ASAP ships is declared, so anything they can do it can do too.</Description>

    <PackageId>ASAP.Extensions.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>ASAP</Authors>
    <PackageTags>asap;erp;extension;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>

    <!-- Symbols and sources travel with the package. An extension author stepping into ASAP's own
         code is an author who can answer their own question, and the alternative is a support
         thread that starts "what does this method actually do". -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\ASAP.Platform.Kernel\ASAP.Platform.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
